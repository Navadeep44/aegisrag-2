# Copy to backend/.env. It works as is.
# DATABASE_URL empty = local SQLite file, nothing to install.
# For Postgres with pgvector set e.g. postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=
FILE_STORAGE_DIR=./data/files
JWT_SECRET=dev-only-change-me

# Demo conveniences: seeded data and one-click login as the demo users.
DEMO_MODE=true
SEED_ON_START=true
DEMO_PASSWORD=change-me-demo

# "local" runs with no API key: keyword-style search, extractive answers, no vision.
# "openai" uses any OpenAI-compatible API. Fill in the four values below.
# "gemini" uses Google AI Studio (set GEMINI_API_KEY below): answers, embeddings and vision OCR.
AI_PROVIDER=local
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_CHAT_MODEL=
AI_EMBED_MODEL=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
