# Copy to .env. Local development values only.
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis_dev_only
POSTGRES_DB=aegisrag

JWT_SECRET=dev-only-change-me

# Demo conveniences: seeded data and one-click login as the demo users.
DEMO_MODE=true
SEED_ON_START=true
DEMO_PASSWORD=change-me-demo

# "local" runs with no API key: keyword-style search, extractive answers, no vision.
# "openai" uses any OpenAI-compatible API. Fill in the four values below.
AI_PROVIDER=local
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_CHAT_MODEL=
AI_EMBED_MODEL=
